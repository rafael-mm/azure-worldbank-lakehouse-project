{
  "name": "AzureWorldBankDark",
  "dataColors": [
    "#38BDF8",
    "#34D399",
    "#818CF8",
    "#FBBF24",
    "#F472B6",
    "#FF8A5C",
    "#89EC5C",
    "#F84C59"
  ],
  "tableAccent": "#38BDF8",
  "good": "#34D399",
  "neutral": "#FBBF24",
  "bad": "#F84C59",
  "maximum": "#38BDF8",
  "center": "#0284C7",
  "minimum": "#1E3A5F",
  "null": "#475569",
  "hyperlink": "#38BDF8",
  "visitedHyperlink": "#818CF8",
  "foreground": "#F1F5F9",
  "foregroundNeutralSecondary": "#94A3B8",
  "foregroundNeutralTertiary": "#64748B",
  "foregroundNeutralLight": "#475569",
  "background": "#161B22",
  "backgroundLight": "#21262D",
  "backgroundNeutral": "#30363D",
  "backgroundDark": "#0D1117",
  "accent": "#38BDF8",
  "shapeStroke": "#30363D",
  "disabledText": "#475569",
  "textClasses": {
    "callout": {
      "fontFace": "DIN",
      "fontSize": 28,
      "color": "#F8FAFC"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#F8FAFC"
    },
    "header": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#94A3B8"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#CBD5E1"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#161B22" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#30363D" } },
            "radius": 10,
            "width": 1
          }
        ],
        "visualHeader": [
          {
            "foreground": { "solid": { "color": "#94A3B8" } },
            "background": { "solid": { "color": "#161B22" } },
            "border": { "solid": { "color": "#30363D" } },
            "transparency": 0
          }
        ],
        "categoryAxis": [
          {
            "gridlineColor": { "solid": { "color": "#21262D" } }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": { "solid": { "color": "#21262D" } }
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#161B22" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#30363D" } },
            "radius": 8,
            "width": 1
          }
        ],
        "header": [
          {
            "fontColor": { "solid": { "color": "#94A3B8" } }
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#F1F5F9" } },
            "background": { "solid": { "color": "#21262D" } },
            "backgroundTransparency": 0
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#161B22" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#30363D" } },
            "radius": 10,
            "width": 1
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": false
          }
        ],
        "divider": [
          {
            "$id": "default",
            "dividerColor": { "solid": { "color": "#30363D" } }
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": { "solid": { "color": "#090D12" } }
          }
        ],
        "background": [
          {
            "color": { "solid": { "color": "#0D1117" } },
            "transparency": 0
          }
        ]
      }
    }
  }
}