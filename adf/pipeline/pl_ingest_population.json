{
	"name": "pl_ingest_population",
	"properties": {
		"activities": [
			{
				"name": "Get population indicator metadata",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://api.worldbank.org/v2/country/all/indicator/SP.POP.TOTL?format=json&per_page=1000&page=1"
				}
			},
			{
				"name": "Loop indicator pages",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get population indicator metadata",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@range(1, int(json(activity('Get population indicator metadata').output.Response)[0].pages))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Ingest population",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "RestSource",
									"additionalColumns": [
										{
											"name": "ingestion_timestamp",
											"value": {
												"value": "@utcNow()",
												"type": "Expression"
											}
										}
									],
									"httpRequestTimeout": "00:01:40",
									"requestInterval": "00.00:00:00.100",
									"requestMethod": "GET"
								},
								"sink": {
									"type": "JsonSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "JsonWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "ds_worldbank_population",
									"type": "DatasetReference",
									"parameters": {
										"p_page": "@item()"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "ds_bronze_hive",
									"type": "DatasetReference",
									"parameters": {
										"v_table_name": "population",
										"v_year": "@formatDateTime(utcNow(), 'yyyy')",
										"v_month": {
											"value": "@formatDateTime(utcNow(), 'MM')",
											"type": "Expression"
										},
										"v_day": {
											"value": "@formatDateTime(utcNow(), 'dd')",
											"type": "Expression"
										},
										"p_page": "@item()"
									}
								}
							]
						}
					]
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-11-09T18:22:24Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}